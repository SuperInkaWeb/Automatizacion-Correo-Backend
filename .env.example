# ─────────────────────────────────────────────────────────────────────
# Plantilla de configuracion. Copiar a .env y completar.
#
#   cp .env.example .env
#
# .env NUNCA se versiona. La configuracion se valida al arrancar: si en
# produccion falta algo obligatorio o hay un valor inseguro, la
# aplicacion no levanta (ver bootstrap/settings.py).
# ─────────────────────────────────────────────────────────────────────

# ── Aplicacion ───────────────────────────────────────────────────────
ENVIRONMENT=development          # development | testing | staging | production
LOG_LEVEL=INFO
API_PREFIX=/api/v1
DOCS_ENABLED=true                # debe ser false en produccion

# ── Base de datos ────────────────────────────────────────────────────
# El usuario de la aplicacion NO debe ser propietario de las tablas ni
# superusuario: PostgreSQL exime a ambos de las politicas RLS y el
# aislamiento entre tenants dejaria de aplicarse sin dar ningun error.
DATABASE_URL=postgresql+asyncpg://mailauto_app:desarrollo@localhost:5432/mailauto
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_COMMAND_TIMEOUT_SECONDS=30
DB_ECHO=false                    # debe ser false en produccion: vuelca SQL con datos

# ── Redis (cola de jobs, pub/sub de progreso, rate limiting) ─────────
REDIS_URL=redis://localhost:6379/0

# ── Identidad (OIDC / Auth0) ─────────────────────────────────────────
OIDC_ISSUER=https://tu-tenant.us.auth0.com/
OIDC_AUDIENCE=https://api.tu-dominio.com/automatizacion-correos
OIDC_JWKS_CACHE_SECONDS=3600
OIDC_ROLES_CLAIM=https://automatizacion-correos/roles

# ── Criptografia ─────────────────────────────────────────────────────
# Clave maestra de 32 bytes en base64. Generar con:
#   python -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
# En produccion debe venir de un KMS o gestor de secretos, nunca de aqui.
MASTER_KEY_B64=
KMS_PROVIDER=local               # solo 'local' esta implementado; 'aws'/'vault' son trabajo futuro
# En produccion, usar 'local' exige aceptar que la clave vive en un secreto
# del entorno (Railway/Cloudflare) y no en un KMS gestionado. Ponlo en true a conciencia.
KMS_LOCAL_EN_PRODUCCION_ACEPTADO=false

# ── OAuth: Google (Gmail API) ────────────────────────────────────────
# Alcance usado: gmail.readonly. Es un RESTRICTED SCOPE de Google:
# publicar en produccion exige verificacion y, al superar el umbral de
# usuarios, una evaluacion de seguridad CASA. Iniciar el tramite pronto.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── OAuth: Microsoft (Graph) ─────────────────────────────────────────
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# Allowlist exacta de URLs de retorno. La comparacion es por igualdad,
# no por prefijo: un prefijo permitiria "https://app.tuyo.com.atacante.io".
OAUTH_REDIRECT_URIS=["http://localhost:3000/oauth/callback"]
OAUTH_STATE_TTL_SECONDS=600

# ── Almacenamiento de objetos (S3 compatible) ────────────────────────
STORAGE_ENDPOINT_URL=http://localhost:4566   # vacio para AWS S3 real
STORAGE_BUCKET=adjuntos
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=desarrollo
STORAGE_SECRET_KEY=desarrollo-secreto
STORAGE_PRESIGN_TTL_SECONDS=300

# ── Limites de ingesta ───────────────────────────────────────────────
MAX_ATTACHMENT_BYTES=26214400        # 25 MB
MAX_ATTACHMENTS_PER_MESSAGE=20
MAX_MESSAGES_PER_SCAN=5000
MAX_SCAN_DATE_RANGE_DAYS=366
ALLOWED_MIME_TYPES=["application/pdf","image/jpeg","image/png","image/webp"]

# ── Extraccion ───────────────────────────────────────────────────────
# El pipeline prueba cuatro motores por orden de costo: texto nativo
# del PDF, tablas, OCR local y, solo si los tres fallan, vision IA.
# Los tres primeros son gratuitos; el cuarto se paga por documento.
#
# Sin clave, la vision no se registra y el pipeline sigue funcionando:
# los documentos ilegibles van a la cola de revision humana.
ANTHROPIC_API_KEY=
VISION_AI_HABILITADA=false
VISION_MODELO=claude-opus-5-5
# Transcribir campos de un formulario conocido es clasificacion, no
# razonamiento: con esfuerzo bajo acierta igual y cuesta una fraccion.
VISION_ESFUERZO=low
# Tope de llamadas de pago por escaneo. Acota el gasto de un trabajo
# con cientos de adjuntos ilegibles.
VISION_MAXIMO_LLAMADAS_POR_TRABAJO=50

# ── Reportes ─────────────────────────────────────────────────────────
REPORTE_MAXIMO_FILAS=50000

# ── Cuotas y rate limiting ───────────────────────────────────────────
RATE_LIMIT_DEFAULT_PER_MINUTE=120
RATE_LIMIT_SCAN_PER_HOUR=20
RATE_LIMIT_OAUTH_PER_HOUR=10
TENANT_MAX_CONCURRENT_SCANS=3

# ── Workers ──────────────────────────────────────────────────────────
WORKER_MAX_JOBS=8
WORKER_JOB_TIMEOUT_SECONDS=1800
WORKER_MAX_TRIES=3

# ── CORS ─────────────────────────────────────────────────────────────
# En produccion: solo https y nunca "*".
CORS_ORIGINS=["http://localhost:3000"]

# ── Privacidad ───────────────────────────────────────────────────────
# El texto OCR crudo es dato fiscal. Apagado por defecto; si se activa
# para diagnostico, se almacena cifrado y con purga automatica.
STORE_RAW_OCR_TEXT=false
RETENTION_DAYS_ATTACHMENTS=365

# ── Observabilidad ───────────────────────────────────────────────────
# Protege /metrics con `Authorization: Bearer <valor>`. OBLIGATORIO en
# produccion: el endpoint revela rutas internas, tasas de error y volumen
# de uso. Generalo con: openssl rand -base64 32
METRICS_TOKEN=
OTEL_EXPORTER_ENDPOINT=http://localhost:4318
# Sentry todavia no esta implementado: la variable queda reservada.
SENTRY_DSN=
